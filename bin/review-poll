#!/usr/bin/env ruby
# frozen_string_literal: true
#
# PR update poller. While review-queue runs, watches opt-in GitHub-PR projects
# (project.yaml with `poll.enabled: true` and a `source`) and enqueues any open
# PR whose head commit changed since it was last enqueued.
#
# Usage: review-poll [--once]
# Env:   REVIEW_POLL_INTERVAL (seconds, default 180)
#        REVIEW_POLL_STATE    (state file, default <repo>/state/poll.state)
#        REVIEW_POLL_COMMITS_NOW (bypass commit-review window+throttle once; don't export permanently)
#        HACKORUM_API         (default https://hackorum.dev/api/v1)

require 'json'
require 'time'
require 'yaml'
require 'fileutils'
require 'shellwords'
require 'net/http'
require 'uri'
require 'set'

$stdout.sync = true

class HackorumError < StandardError
  attr_reader :status, :code

  def initialize(status, code, message = nil)
    @status = status
    @code = code
    super(message || "hackorum HTTP #{status}#{code ? " #{code}" : ''}")
  end
end

class ReviewPoll
  attr_reader :state, :base_dir

  def initialize(once: false, base_dir: File.expand_path('..', __dir__))
    @base_dir = base_dir
    @workspace_dir = File.expand_path(env_or('WORKSPACE_DIR', File.join(@base_dir, 'workspace')))
    @projects_dir = @workspace_dir
    state_dir = File.expand_path(env_or('STATE_DIR', File.join(@base_dir, 'state')))
    @state_file = env_or('REVIEW_POLL_STATE', File.join(state_dir, 'poll.state'))
    FileUtils.mkdir_p(File.dirname(@state_file))
    @queue_file = env_or('REVIEW_QUEUE_FILE', File.join(state_dir, 'queue'))
    @queue_processed_file = env_or('REVIEW_QUEUE_PROCESSED', File.join(state_dir, 'queue.processed'))
    @interval = (ENV['REVIEW_POLL_INTERVAL'] || 180).to_i
    @once = once
    @state = load_state
  end

  def env_or(name, default)
    v = ENV[name].to_s
    v.empty? ? default : v
  end

  def load_state
    return {} unless File.exist?(@state_file)
    JSON.parse(File.read(@state_file))
  rescue JSON::ParserError
    warn "review-poll: corrupt state file #{@state_file}, starting fresh"
    {}
  end

  def save_state
    File.write(@state_file, JSON.pretty_generate(@state) + "\n")
  end

  def enabled_projects
    Dir.glob(File.join(@projects_dir, '*', 'project.yaml')).sort.filter_map do |yaml|
      cfg = YAML.safe_load_file(yaml)
      next unless cfg && cfg.dig('poll', 'enabled') && cfg['base_branch']
      dir_name = File.basename(File.dirname(yaml))
      raw_name = cfg['name']
      {
        name:        raw_name.is_a?(String) ? raw_name : dir_name,
        source:      cfg['source'],
        prefix:      cfg['topic_prefix'] || 'pr',
        base_branch: cfg['base_branch'],
        master_dir:  File.join(@projects_dir, dir_name, 'master'),
        findings_dir: File.join(@projects_dir, dir_name, 'findings'),
        only_reviewed: cfg.dig('poll', 'only_reviewed') == true,
        skip_drafts: cfg.dig('poll', 'skip_drafts') == true,
        hackorum:    cfg.dig('poll', 'hackorum') == true,
        commit_review: cfg['commit_review'],
        debounce_minutes: [(cfg.dig('poll', 'debounce_minutes') || DEBOUNCE_MINUTES_DEFAULT).to_i, 0].max,
      }
    rescue StandardError => e
      warn "review-poll: skipping #{yaml}: #{e.message}"
      nil
    end
  end

  DEBOUNCE_MINUTES_DEFAULT = 120

  # Pure. pending: {topic => {"head", "seen_at"}}. Returns [enqueue_now?, new pending].
  def debounce_ready?(pending, topic, head, now, minutes)
    rest = pending.reject { |t, _| t == topic }
    return [true, rest] if minutes <= 0

    entry = pending[topic]
    seen = entry.is_a?(Hash) && entry['head'] == head ? (Time.iso8601(entry['seen_at'].to_s) rescue nil) : nil
    return [false, rest.merge(topic => { 'head' => head, 'seen_at' => now.getutc.iso8601 })] unless seen

    now - seen >= minutes * 60 ? [true, rest] : [false, pending]
  end

  # A manual enqueue or an earlier review may already cover this head.
  def already_handled?(proj, topic, head)
    return true if queued_topics(proj[:name]).include?(topic)
    return false unless proj[:findings_dir]

    meta = File.join(File.dirname(proj[:findings_dir]), 'review', topic, 'metadata.json')
    File.exist?(meta) && JSON.parse(File.read(meta))['head_sha'] == head
  rescue JSON::ParserError, SystemCallError
    false
  end

  # Pure classifier. prev: nil (project not yet baselined) or Hash{topic => sha}.
  # prs: Array of {topic:, head:, draft:}. Returns {baseline:, decisions:[{topic:,head:,draft:,status:}]}.
  def plan(prev, prs)
    return { baseline: true, decisions: [] } if prev.nil?
    decisions = prs.map do |pr|
      status = prev[pr[:topic]] == pr[:head] ? :unchanged : :changed
      { topic: pr[:topic], head: pr[:head], draft: pr[:draft] == true, status: status }
    end
    { baseline: false, decisions: decisions }
  end

  COMMIT_WINDOW_DEFAULT = '02:00-05:00'
  COMMIT_MAX_BATCH_DEFAULT = 10
  COMMIT_MIN_GAP = 20 * 3600 # once per day, tolerant of window-edge drift
  COMMIT_BASELINE_DEPTH = 20

  def in_window?(now, window_str)
    window_str = COMMIT_WINDOW_DEFAULT if window_str.nil? || window_str.empty?
    m = window_str.match(/\A(\d{1,2}):(\d{2})-(\d{1,2}):(\d{2})\z/)
    return false unless m
    start_m = m[1].to_i * 60 + m[2].to_i
    end_m   = m[3].to_i * 60 + m[4].to_i
    cur = now.hour * 60 + now.min
    start_m <= end_m ? (cur >= start_m && cur < end_m) : (cur >= start_m || cur < end_m)
  end

  def commit_batch_due?(cr_state, now, window_str, bypass: false)
    return true if bypass
    return false unless in_window?(now, window_str)
    last = cr_state && cr_state['last_enqueued_at']
    last_t = (Time.parse(last) rescue nil) if last
    last_t.nil? || (now - last_t) >= COMMIT_MIN_GAP
  end

  # shas: new commits oldest-first. Returns consecutive [from, to] ranges
  # chained from last_sha, each covering at most max_batch commits.
  # Assumes linear history: with merges, consecutive ranges may overlap (never lose commits).
  def chunk_commits(last_sha, shas, max_batch)
    max_batch = COMMIT_MAX_BATCH_DEFAULT if max_batch.to_i < 1
    from = last_sha
    shas.each_slice(max_batch).map do |slice|
      chunk = [from, slice.last]
      from = slice.last
      chunk
    end
  end

  def git_out(dir, *args)
    out = nil
    IO.popen(['git', '-C', dir, *args], err: File::NULL) { |io| out = io.read }
    $?.success? ? out.strip : nil
  end

  def baseline_sha(dir, head)
    git_out(dir, 'rev-parse', "#{head}~#{COMMIT_BASELINE_DEPTH}") || head
  end

  def commit_review_state(name)
    st = @state[name]
    st.is_a?(Hash) ? st['commit_review'] : nil
  end

  def store_commit_review_state(name, cr)
    st = @state[name]
    st = {} unless st.is_a?(Hash)
    st['commit_review'] = cr
    @state[name] = st
    save_state
  end

  def enqueue_commit_batch(project, from, to)
    system(File.join(@base_dir, 'bin', 'enqueue'), project, 'commits', "#{from}..#{to}",
           out: File::NULL, err: File::NULL)
  end

  def process_commit_reviews(proj, enqueue_commits: method(:enqueue_commit_batch), now: Time.now)
    cfg = proj[:commit_review]
    return unless cfg.is_a?(Hash) && cfg['command']
    return log("WARNING: #{proj[:name]}: #{proj[:master_dir]} is not a git repo") unless git_repo?(proj[:master_dir])

    head = git_out(proj[:master_dir], 'rev-parse', "origin/#{proj[:base_branch]}")
    return log("WARNING: #{proj[:name]}: cannot resolve origin/#{proj[:base_branch]}") unless head

    cr = commit_review_state(proj[:name])
    if cr.nil? || cr['last_sha'].nil?
      base = baseline_sha(proj[:master_dir], head)
      store_commit_review_state(proj[:name], { 'last_sha' => base })
      return log("#{proj[:name]}: commit-review baseline #{base[0, 7]}")
    end

    bypass = !ENV['REVIEW_POLL_COMMITS_NOW'].to_s.empty?
    return unless commit_batch_due?(cr, now, cfg['window'], bypass: bypass)

    raw = git_out(proj[:master_dir], 'rev-list', '--reverse', "#{cr['last_sha']}..#{head}")
    if raw.nil?
      base = baseline_sha(proj[:master_dir], head)
      log "WARNING: #{proj[:name]}: #{cr['last_sha'][0, 7]} not in origin/#{proj[:base_branch]}, re-baselining to #{base[0, 7]}"
      return store_commit_review_state(proj[:name], { 'last_sha' => base })
    end
    shas = raw.split("\n").reject(&:empty?)
    return if shas.empty?

    max_batch = (cfg['max_batch'] || COMMIT_MAX_BATCH_DEFAULT).to_i
    chunks = chunk_commits(cr['last_sha'], shas, max_batch)
    chunks.each_with_index do |(from, to), i|
      unless enqueue_commits.call(proj[:name], from, to)
        log "#{proj[:name]}: commits #{from[0, 7]}..#{to[0, 7]} enqueue failed, remainder retries next window"
        break
      end
      store_commit_review_state(proj[:name],
                                { 'last_sha' => to, 'last_enqueued_at' => now.getutc.iso8601 })
      log "#{proj[:name]}: commits #{from[0, 7]}..#{to[0, 7]} enqueued (chunk #{i + 1}/#{chunks.size})"
    end
  end

  HACKORUM_API = 'https://hackorum.dev/api/v1'

  def hackorum_parse(status, body)
    parsed = begin
      JSON.parse(body.to_s)
    rescue JSON::ParserError
      nil
    end
    return parsed if status.between?(200, 299) && parsed.is_a?(Hash)

    code = parsed.is_a?(Hash) ? parsed.dig('error', 'code') : nil
    raise HackorumError.new(status, code)
  end

  def hackorum_get(path, params = {})
    uri = URI("#{env_or('HACKORUM_API', HACKORUM_API)}#{path}")
    uri.query = URI.encode_www_form(params) unless params.empty?
    res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https',
                          open_timeout: 15, read_timeout: 60) do |http|
      http.get(uri.request_uri, 'Accept' => 'application/json')
    end
    hackorum_parse(res.code.to_i, res.body)
  rescue HackorumError
    raise
  rescue StandardError => e
    raise HackorumError.new(0, nil, "hackorum request failed: #{e.message}")
  end

  HACKORUM_PENDING_TTL = 24 * 3600

  def hackorum_state(name)
    st = @state[name]
    hk = st.is_a?(Hash) ? st['hackorum'] : nil
    hk.is_a?(Hash) ? hk : {}
  end

  def store_hackorum_state(name, hk)
    st = @state[name]
    st = {} unless st.is_a?(Hash)
    st['hackorum'] = hk
    @state[name] = st
    save_state
  end

  def hackorum_baseline(proj, hk, fetch, now)
    page = fetch.call('/events', types: 'branch.created', since: now.getutc.iso8601)
    unless page.is_a?(Hash) && page['next_cursor']
      log "WARNING: #{proj[:name]}: hackorum baseline returned no cursor, will retry"
      return
    end
    hk['cursor'] = page['next_cursor']
    hk['pending'] ||= {}
    hk['enqueued'] ||= {}
    store_hackorum_state(proj[:name], hk)
    log "#{proj[:name]}: hackorum baseline recorded"
  end

  def queued_topics(project)
    return Set.new unless File.exist?(@queue_file)
    offset = File.exist?(@queue_processed_file) ? File.read(@queue_processed_file).strip.to_i : 0
    lines = File.readlines(@queue_file, chomp: true).reject(&:empty?)
    lines.drop(offset + 1).filter_map do |l|
      w = l.split
      w[1] if w[0] == project
    end.to_set
  end

  # true unless the enqueue itself failed
  def hackorum_candidate(proj, hk, topic, n, enqueue)
    if hk['enqueued'][topic].to_i >= n
      return true
    end
    if Dir.exist?(File.join(proj[:findings_dir].to_s, topic, "v#{n}"))
      log "#{proj[:name]}: #{topic} v#{n} already reviewed, skipped"
      return true
    end
    if proj[:only_reviewed] && !Dir.exist?(File.join(proj[:findings_dir].to_s, topic))
      log "#{proj[:name]}: #{topic} v#{n} not reviewed yet, skipped (only_reviewed)"
      return true
    end
    if @hackorum_fresh.include?(topic) || queued_topics(proj[:name]).include?(topic)
      hk['enqueued'][topic] = n
      log "#{proj[:name]}: #{topic} v#{n} already queued, skipped"
      return true
    end
    unless enqueue.call(proj[:name], topic)
      log "#{proj[:name]}: #{topic} v#{n} enqueue failed, will retry next cycle"
      return false
    end
    hk['enqueued'][topic] = n
    @hackorum_fresh << topic
    log "#{proj[:name]}: #{topic} v#{n} enqueued"
    true
  end

  def hackorum_branch(proj, hk, br, enqueue, now)
    unless br.is_a?(Hash)
      log "#{proj[:name]}: hackorum event without branch, skipped"
      return true
    end
    m = br['branch_name'].to_s.match(/\At(\d+)_(\d+)\z/)
    unless m
      log "#{proj[:name]}: hackorum branch #{br['branch_name'].inspect} unparsable, skipped"
      return true
    end
    topic = "t#{m[1]}"
    n = m[2].to_i
    if br['status'] != 'applied'
      log "#{proj[:name]}: #{topic} v#{n} did not apply, skipped"
      return true
    end
    if br['pushed_at'].nil?
      return true if hk['enqueued'][topic].to_i >= n
      if br['id'].nil?
        log "#{proj[:name]}: hackorum branch without id, skipped"
        return true
      end
      hk['pending'][br['id'].to_s] ||= { 'topic' => topic, 'number' => n, 'seen_at' => now.getutc.iso8601 }
      return true
    end
    hackorum_candidate(proj, hk, topic, n, enqueue)
  end

  def hackorum_recheck_pending(proj, hk, fetch, enqueue, now)
    hk['pending'].keys.each do |id|
      entry = hk['pending'][id]
      unless entry.is_a?(Hash)
        hk['pending'].delete(id)
        log "#{proj[:name]}: hackorum pending entry #{id} malformed, dropped"
        next
      end
      seen = (Time.parse(entry['seen_at']) rescue nil)
      if seen.nil? || now - seen > HACKORUM_PENDING_TTL
        hk['pending'].delete(id)
        log "#{proj[:name]}: #{entry['topic']} v#{entry['number']} never pushed, dropped"
        next
      end
      br = begin
        fetch.call("/branches/#{id}")
      rescue HackorumError => e
        log "WARNING: #{proj[:name]}: hackorum branch #{id} recheck failed: #{e.message}"
        break
      end
      unless br.is_a?(Hash)
        hk['pending'].delete(id)
        log "#{proj[:name]}: hackorum branch #{id} malformed, dropped"
        next
      end
      if br['status'] != 'applied'
        hk['pending'].delete(id)
        log "#{proj[:name]}: #{entry['topic']} v#{entry['number']} did not apply, dropped"
      elsif br['pushed_at'] && hackorum_candidate(proj, hk, entry['topic'], entry['number'].to_i, enqueue)
        hk['pending'].delete(id)
      end
    end
  end

  def process_hackorum(proj, fetch: method(:hackorum_get), enqueue: method(:enqueue_topic), now: Time.now)
    hk = hackorum_state(proj[:name])
    @hackorum_fresh = Set.new
    return hackorum_baseline(proj, hk, fetch, now) unless hk['cursor']

    hk['pending'] ||= {}
    hk['enqueued'] ||= {}
    hackorum_recheck_pending(proj, hk, fetch, enqueue, now)
    store_hackorum_state(proj[:name], hk)
    loop do
      page = fetch.call('/events', types: 'branch.created', limit: 200, since: hk['cursor'])
      raise HackorumError.new(0, nil, 'malformed events page') unless page.is_a?(Hash) && page['data'].is_a?(Array)
      ok = page['data'].all? do |ev|
        !ev.is_a?(Hash) ? hackorum_branch(proj, hk, nil, enqueue, now) :
          ev['type'] != 'branch.created' || hackorum_branch(proj, hk, ev['branch'], enqueue, now)
      end
      unless ok
        store_hackorum_state(proj[:name], hk)
        return
      end
      hk['cursor'] = page['next_cursor'] || hk['cursor']
      store_hackorum_state(proj[:name], hk)
      break unless page['has_more'] && page['next_cursor']
    end
  rescue HackorumError => e
    if e.code == 'cursor_expired'
      log "WARNING: #{proj[:name]}: hackorum cursor expired, re-baselining (missed events are not reviewed)"
      hk.delete('cursor')
      begin
        hackorum_baseline(proj, hk, fetch, now)
      rescue HackorumError => e2
        log "WARNING: #{proj[:name]}: hackorum re-baseline failed: #{e2.message}"
      end
    else
      store_hackorum_state(proj[:name], hk) if hk['cursor']
      log "WARNING: #{proj[:name]}: hackorum poll failed, skipping this cycle: #{e.message}"
    end
  end

  def open_prs(source)
    raw = nil
    IO.popen(['gh', '-R', source, 'pr', 'list', '--state', 'open',
              '--json', 'number,headRefOid,baseRefName,isDraft', '--limit', '200']) { |io| raw = io.read }
    unless $?.success?
      log "WARNING: gh pr list failed for #{source}, skipping this cycle"
      return nil
    end
    JSON.parse(raw).map do |p|
      { number: p['number'], head: p['headRefOid'], base: p['baseRefName'], draft: p['isDraft'] == true }
    end
  rescue JSON::ParserError => e
    log "WARNING: could not parse gh output for #{source}: #{e.message}"
    nil
  rescue SystemCallError => e
    log "WARNING: could not run gh for #{source}: #{e.message}"
    nil
  end

  def enqueue_topic(project, topic)
    system(File.join(@base_dir, 'bin', 'enqueue'), project, topic,
           out: File::NULL, err: File::NULL)
  end

  def git_repo?(dir)
    dir && File.directory?(dir) &&
      system('git', '-C', dir, 'rev-parse', '--git-dir', out: File::NULL, err: File::NULL)
  end

  def checked_out_branch(dir)
    branch = nil
    IO.popen(['git', '-C', dir, 'symbolic-ref', '--quiet', '--short', 'HEAD'],
             err: File::NULL) { |io| branch = io.read.to_s.strip }
    $?.success? && !branch.empty? ? branch : nil
  end

  def refresh_one(master_dir, base)
    return log("WARNING: #{master_dir} is not a git repo, skipping base #{base}") unless git_repo?(master_dir)
    unless system('git', '-C', master_dir, 'fetch', 'origin', base, out: File::NULL, err: File::NULL)
      return log("WARNING: git fetch origin #{base} failed in #{master_dir}")
    end
    ok =
      if checked_out_branch(master_dir) == base
        system('git', '-C', master_dir, 'reset', '--hard', "origin/#{base}", out: File::NULL, err: File::NULL)
      else
        system('git', '-C', master_dir, 'branch', '-f', base, "origin/#{base}", out: File::NULL, err: File::NULL)
      end
    ok ? log("refreshed #{base} in #{master_dir}") : log("WARNING: could not update #{base} in #{master_dir}")
  end

  def refresh_bases(proj, bases)
    bases.compact.uniq.each { |b| refresh_one(proj[:master_dir], b) }
  end

  def run_once(projects: enabled_projects, fetch: method(:open_prs),
               enqueue: method(:enqueue_topic), refresh: method(:refresh_bases),
               enqueue_commits: method(:enqueue_commit_batch),
               hackorum_fetch: method(:hackorum_get), now: Time.now)
    return if projects.empty?
    log "poll cycle: #{projects.map { |p| p[:name] }.join(', ')}"
    projects.each do |proj|
      if proj[:source]
        raw = fetch.call(proj[:source])
        next if raw.nil?
        prs = raw.map { |p| { topic: "#{proj[:prefix]}#{p[:number]}", head: p[:head], draft: p[:draft] == true } }
        bases = raw.map { |p| p[:base] }.compact.uniq | [proj[:base_branch]]
      else
        prs = []
        bases = [proj[:base_branch]]
      end

      refresh.call(proj, bases)
      prev = @state[proj[:name]] # read before commit reviews touch state
      process_commit_reviews(proj, enqueue_commits: enqueue_commits, now: now) if proj[:commit_review]
      if proj[:hackorum]
        begin
          process_hackorum(proj, fetch: hackorum_fetch, enqueue: enqueue, now: now)
        rescue StandardError => e
          log "WARNING: #{proj[:name]}: hackorum step crashed: #{e.class}: #{e.message}"
        end
      end
      next unless proj[:source]

      result = plan(prev, prs)
      cr = commit_review_state(proj[:name])
      cur = @state[proj[:name]]
      hk_keep = cur.is_a?(Hash) ? cur['hackorum'] : nil
      if result[:baseline]
        skipped, tracked = prs.partition { |pr| proj[:skip_drafts] && pr[:draft] }
        new_map = tracked.to_h { |pr| [pr[:topic], pr[:head]] }
        new_map['drafts'] = skipped.to_h { |pr| [pr[:topic], pr[:head]] } unless skipped.empty?
        new_map['commit_review'] = cr if cr
        new_map['hackorum'] = hk_keep if hk_keep
        @state[proj[:name]] = new_map
        log "#{proj[:name]}: baseline recorded (#{prs.size} open PRs)"
      else
        new_state = {}
        open_topics = prs.map { |pr| pr[:topic] }
        pending = (prev['debounce'].is_a?(Hash) ? prev['debounce'] : {}).select { |t, _| open_topics.include?(t) }
        prev_drafts = prev['drafts'].is_a?(Hash) ? prev['drafts'] : {}
        drafts = {}
        result[:decisions].each do |d|
          if proj[:skip_drafts] && d[:draft]
            # Drafts are not tracked: once marked ready for review, the PR is
            # polled as new (already_handled? covers an unchanged reviewed head).
            drafts[d[:topic]] = d[:head]
            pending = pending.reject { |t, _| t == d[:topic] }
            unless prev_drafts[d[:topic]] == d[:head]
              log "#{proj[:name]}: #{d[:topic]} draft #{d[:head][0, 7]}, skipped (skip_drafts)"
            end
            next
          end
          case d[:status]
          when :unchanged
            new_state[d[:topic]] = d[:head]
          when :changed
            kind = prev.key?(d[:topic]) ? 'new commits' : 'new PR'
            if proj[:only_reviewed] && !Dir.exist?(File.join(proj[:findings_dir].to_s, d[:topic]))
              # Track the head without reviewing: once the PR is reviewed by
              # hand, its later pushes are polled like any other.
              new_state[d[:topic]] = d[:head]
              log "#{proj[:name]}: #{d[:topic]} #{kind} #{d[:head][0, 7]}, not reviewed yet, skipped (only_reviewed)"
              next
            end
            minutes = proj[:debounce_minutes].to_i
            ready, pending = debounce_ready?(pending, d[:topic], d[:head], now, minutes)
            if !ready
              new_state[d[:topic]] = prev[d[:topic]] if prev.key?(d[:topic])
              log "#{proj[:name]}: #{d[:topic]} #{kind} #{d[:head][0, 7]}, waiting for quiet (#{minutes} min)"
            elsif minutes.positive? && already_handled?(proj, d[:topic], d[:head])
              new_state[d[:topic]] = d[:head]
              log "#{proj[:name]}: #{d[:topic]} #{kind} #{d[:head][0, 7]}, already queued or reviewed, skipped"
            elsif enqueue.call(proj[:name], d[:topic])
              new_state[d[:topic]] = d[:head]
              log "#{proj[:name]}: #{d[:topic]} #{kind} #{d[:head][0, 7]}, enqueued"
            else
              # keep the quiet period satisfied so the next cycle retries at once
              pending = pending.merge(d[:topic] => { 'head' => d[:head], 'seen_at' => (now - minutes * 60).getutc.iso8601 }) if minutes.positive?
              new_state[d[:topic]] = prev[d[:topic]] if prev.key?(d[:topic])
              log "#{proj[:name]}: #{d[:topic]} enqueue failed, will retry next cycle"
            end
          end
        end
        new_state['debounce'] = pending unless pending.empty?
        new_state['drafts'] = drafts unless drafts.empty?
        new_state['commit_review'] = cr if cr
        new_state['hackorum'] = hk_keep if hk_keep
        @state[proj[:name]] = new_state
      end
      save_state
    end
  end

  def run
    puts '=== Review PR Poller ==='
    puts "State file: #{@state_file}"
    puts "Interval:   #{@interval}s"
    puts ''
    loop do
      run_once
      break if @once
      sleep @interval
    end
  end

  def log(msg)
    puts "[#{Time.now.strftime('%H:%M:%S')}] #{msg}"
  end
end

if __FILE__ == $0
  ReviewPoll.new(once: ARGV.include?('--once')).run
end
