#!/usr/bin/env ruby
# frozen_string_literal: true

# Checks that each GitHub-PR project's review-patch command matches the
# _git-pr template outside the marked project-specific regions.
# Exit 0 when clean, 1 when any project drifted.

require 'tempfile'
require 'yaml'

BASE = File.expand_path('..', __dir__)
WORKSPACE = File.expand_path(ENV['WORKSPACE_DIR'] || File.join(BASE, 'workspace'))
TEMPLATE = File.join(WORKSPACE, '.claude/commands/_git-pr/review-patch.md')
unless File.exist?(TEMPLATE)
  puts 'drift check skipped: no _git-pr template in workspace'
  exit 0
end
PROJECTS = Dir.glob(File.join(WORKSPACE, '*', 'project.yaml')).sort.filter_map do |yaml|
  next if File.basename(File.dirname(yaml)).start_with?('_')

  cfg = begin
    YAML.safe_load_file(yaml)
  rescue StandardError
    nil
  end
  cfg['name'] if cfg.is_a?(Hash) && cfg.dig('ingestion', 'hook') == 'github-pr'
end
MARKED = /^<!-- project-specific:start -->$.*?^<!-- project-specific:end -->$\n?/m

def spine(text)
  text.gsub(MARKED, "<<project-specific>>\n")
end

template = File.read(TEMPLATE)
PHASES_ROOT = File.join(WORKSPACE, '.claude/review-phases')
PHASE_TEMPLATE = File.join(PHASES_ROOT, '_git-pr')
drifted = false

def show_diff(label, expected, actual_label, actual)
  a = Tempfile.new(['expected', '.md'])
  a.write(expected)
  a.close
  b = Tempfile.new(['actual', '.md'])
  b.write(actual)
  b.close
  system('diff', '-u', '--label', label, '--label', actual_label, a.path, b.path)
  File.unlink(a.path, b.path)
end

def phase_files(dir)
  Dir.children(dir).select { |f| File.file?(File.join(dir, f)) }.sort
end

# Returns true when the project's phase dir matches the template.
def check_phases(proj)
  tdir = PHASE_TEMPLATE
  pdir = File.join(PHASES_ROOT, proj)
  unless File.directory?(pdir)
    warn "#{proj}: MISSING #{pdir}"
    return false
  end

  ok = true
  tfiles = phase_files(tdir)
  tfiles.each do |f|
    path = File.join(pdir, f)
    unless File.exist?(path)
      warn "#{proj}: MISSING #{path}"
      ok = false
      next
    end
    expected = spine(File.read(File.join(tdir, f)).gsub('<PROJECT>', proj))
    actual = spine(File.read(path))
    next if expected == actual

    ok = false
    puts "#{proj}: DRIFT #{f}"
    show_diff("template(#{proj})/#{f}", expected, path, actual)
  end
  (phase_files(pdir) - tfiles).each do |f|
    warn "#{proj}: EXTRA #{File.join(pdir, f)}"
    ok = false
  end
  ok
end

PROJECTS.each do |proj|
  cmd_path = File.join(WORKSPACE, '.claude/commands', proj, 'review-patch.md')
  unless File.exist?(cmd_path)
    warn "#{proj}: MISSING #{cmd_path}"
    drifted = true
    next
  end

  expected = spine(template.gsub('<PROJECT>', proj))
  actual = spine(File.read(cmd_path))

  if expected == actual
    cmd_ok = true
  else
    cmd_ok = false
    puts "#{proj}: DRIFT"
    show_diff("template(#{proj})", expected, cmd_path, actual)
  end

  phases_ok = File.directory?(PHASE_TEMPLATE) ? check_phases(proj) : true
  drifted ||= !(cmd_ok && phases_ok)
  puts "#{proj}: OK" if cmd_ok && phases_ok
end

exit(drifted ? 1 : 0)
