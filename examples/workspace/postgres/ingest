#!/usr/bin/env ruby
# frozen_string_literal: true
#
# postgres ingestion hook.
# Checks out the branch hackorum CI already built for the latest patchset
# (hackorum-dev/postgres t<topic>_<message_number>) and writes metadata per the
# project ingestion contract. No branch means the patch does not apply.
#
# Usage: ingest --project <project.yaml> <topic>
#   <topic> may be "t139942" or "139942"; the canonical dir name is "t139942".

require 'yaml'
require 'json'
require 'optparse'
require 'net/http'
require 'erb'
require 'fileutils'
require 'open3'

HACKORUM = 'https://hackorum.dev'
BRANCH_REPO = 'https://github.com/hackorum-dev/postgres'

def fetch_json(url, limit = 5)
  abort "ERROR: too many redirects: #{url}" if limit.zero?

  res = Net::HTTP.get_response(URI(url))
  case res
  when Net::HTTPRedirection then fetch_json(URI.join(url, res['location']).to_s, limit - 1)
  when Net::HTTPSuccess then [res.body, JSON.parse(res.body)]
  else abort "ERROR: #{url}: HTTP #{res.code}"
  end
end

def git(dir, *args)
  out, status = Open3.capture2('git', '-C', dir, *args)
  abort "ERROR: git #{args.join(' ')} failed" unless status.success?
  out.strip
end

project_yaml = nil
OptionParser.new do |o|
  o.on('--project PATH', 'Path to project.yaml') { |v| project_yaml = v }
end.order!(ARGV)

abort 'ERROR: --project <project.yaml> is required' unless project_yaml
topic_arg = ARGV.shift
abort 'ERROR: topic argument is required' unless topic_arg

project_yaml = File.expand_path(project_yaml)
config = YAML.safe_load_file(project_yaml)
project_dir = File.dirname(project_yaml)

numeric   = topic_arg.sub(/\At/, '')
canonical = "t#{numeric}"
master    = File.join(project_dir, 'master')
abort "ERROR: invalid topic: #{topic_arg}" unless numeric =~ /\A\d+\z/
abort "ERROR: master checkout not found: #{master}" unless File.directory?(master)

summary_raw, summary = fetch_json("#{HACKORUM}/topics/#{numeric}/summary")
messages_raw, messages = fetch_json("#{HACKORUM}/topics/#{numeric}/messages")

msgnum = (summary['patchsets'] || []).map { |ps| ps['message_number'] }.max
abort "ERROR: topic #{numeric} has no patchsets" unless msgnum

branch = "#{canonical}_#{msgnum}"
ref = "refs/hackorum/#{branch}"

# single-ref fetch: the fork has tens of thousands of refs
puts "ingest: fetching #{BRANCH_REPO} #{branch}"
unless system('git', '-C', master, 'fetch', '--no-tags', BRANCH_REPO, "+refs/heads/#{branch}:#{ref}")
  abort "ERROR: no hackorum branch #{branch}: patch does not apply (or hackorum CI has not processed it yet)"
end

tip_msg = git(master, 'log', '-1', '--format=%B', ref)
unless tip_msg.lines.first.to_s.strip == "hackorum CI for #{branch}" && tip_msg =~ /^Hackorum-Base:\s*([0-9a-f]{40})\s*$/
  abort "ERROR: unexpected tip commit on #{branch} (no hackorum CI commit / Hackorum-Base trailer)"
end
base = Regexp.last_match(1)
head = git(master, 'rev-parse', "#{ref}^")
unless system('git', '-C', master, 'merge-base', '--is-ancestor', base, head)
  abort "ERROR: Hackorum-Base #{base} is not an ancestor of #{head}"
end

review_dir = File.join(project_dir, 'review', canonical)
review_branch = "review/#{canonical}"
if File.exist?(review_dir)
  system('git', '-C', master, 'worktree', 'remove', '--force', review_dir, err: File::NULL)
  FileUtils.rm_rf(review_dir)
  system('git', '-C', master, 'worktree', 'prune')
end
FileUtils.mkdir_p(File.dirname(review_dir))
git(master, 'worktree', 'add', '-B', review_branch, review_dir, head)
puts "ingest: worktree #{review_dir} at #{head[0, 12]} (base #{base[0, 12]}, #{git(master, 'rev-list', '--count', "#{base}..#{head}")} commits)"

hk_dir = File.join(review_dir, '.hackorum')
FileUtils.mkdir_p(hk_dir)
git(review_dir, 'format-patch', '--quiet', '-o', hk_dir, "#{base}..#{head}")
File.write(File.join(hk_dir, 'summary.json'), summary_raw)
File.write(File.join(hk_dir, 'messages.json'), messages_raw)

root_id = (messages['messages'] || []).first&.dig('external_message_id')
source_url = root_id && "https://www.postgresql.org/message-id/flat/#{ERB::Util.url_encode(root_id)}"

normalized = {
  'project'         => config['name'],
  'topic'           => canonical,
  'version'         => msgnum,
  'title'           => summary['title'],
  'source_url'      => source_url,
  'hackorum_url'    => "#{HACKORUM}/topics/#{numeric}",
  'hackorum_branch' => branch,
  'base_commit'     => base,
  'head_commit'     => head,
  'base_branch'     => config['base_branch'],
}.compact

out = File.join(review_dir, 'metadata.json')
File.write(out, JSON.pretty_generate(normalized) + "\n")
puts "ingest: wrote normalized metadata -> #{out}"
