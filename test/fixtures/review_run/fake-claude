#!/usr/bin/env ruby
# frozen_string_literal: true

# Test double for `claude -p --output-format stream-json`.
# Plan (FAKE_CLAUDE_PLAN, JSON): {"<phase>": {"write": [..], "files": {"<path>": "<body>"}, "commit": true,
#   "commit_files": false, "exit": 0, "no_result": false, "limit_first": false, "limit_times": 0,
#   "limit_agent": null, "limit_text": "...", "limit_event": {rate_limit_info}, "rate_limit": {rate_limit_info},
#   "noise": false, "text": "..."}}
# commit_files: also commit the files entries.
# limit_first / limit_times: the first 1 / N calls for the phase hit the usage limit: error result
#   with limit_text, preceded by a rate_limit_event carrying limit_event when given.
# limit_agent: only that agent hits the limit.
# rate_limit: rate_limit_event emitted on calls that do not hit the limit.

require 'json'
require 'fileutils'

Encoding.default_external = Encoding::UTF_8

ENV_SEEN = %w[REVIEW_DONE_FILE REVIEW_RUN CLAUDE_CODE_DISABLE_BACKGROUND_TASKS].freeze
LIMIT_TEXT = "You've hit your 5-hour limit \u00b7 resets 3pm (Europe/Budapest)"

if ARGV.include?('--version')
  puts '9.9.9 (fake)'
  exit 0
end

prompt = $stdin.read
phase = prompt[/^Phase: (\S+)/, 1] || 'commits'
outdir = prompt[/^Output directory: (.+)$/, 1]

plan_file = ENV['FAKE_CLAUDE_PLAN']
plan = plan_file && File.exist?(plan_file) ? JSON.parse(File.read(plan_file)) : {}
step = { 'write' => [], 'commit' => true, 'exit' => 0, 'no_result' => false,
         'limit_first' => false }.merge(plan.fetch(phase, {}))

calls_file = ENV['FAKE_CLAUDE_CALLS']
prior = calls_file && File.exist?(calls_file) ? File.readlines(calls_file).map { |l| JSON.parse(l) } : []
if calls_file
  File.open(calls_file, 'a') do |f|
    f.puts(JSON.generate('agent' => 'claude', 'phase' => phase, 'argv' => ARGV, 'done_file_env' => ENV.key?('REVIEW_DONE_FILE'),
                         'env' => ENV.slice(*ENV_SEEN), 'cwd' => Dir.pwd, 'outdir' => outdir,
                         'replay_note' => prompt.include?('Replay of a past review:'),
                         'note' => prompt.include?('independent discovery pass'),
                         'discovery_note' => prompt.include?('Discovery pass:')))
  end
end

session = "fake-#{phase}"
$stdout.sync = true
puts JSON.generate('type' => 'system', 'subtype' => 'init', 'session_id' => session, 'model' => 'fake-model')
warn 'fake-claude: stderr noise' if step['noise']

def rate_limit_event(info, session)
  puts JSON.generate('type' => 'rate_limit_event', 'rate_limit_info' => info, 'uuid' => 'u1', 'session_id' => session)
end

limit_times = step['limit_times'] || (step['limit_first'] ? 1 : 0)
limit_times = 0 if step['limit_agent'] && step['limit_agent'] != 'claude'
if prior.count { |c| c['phase'] == phase } < limit_times
  rate_limit_event(step['limit_event'], session) if step['limit_event']
  puts JSON.generate('type' => 'result', 'subtype' => 'success', 'is_error' => true,
                     'result' => step['limit_text'] || LIMIT_TEXT,
                     'session_id' => session, 'num_turns' => 1, 'duration_ms' => 10, 'total_cost_usd' => 0.01,
                     'modelUsage' => { 'fake-model' => { 'inputTokens' => 1, 'outputTokens' => 2, 'costUSD' => 0.01 } })
  exit 1
end
rate_limit_event(step['rate_limit'], session) if step['rate_limit']

extra = (step['files'] || {}).map do |path, body|
  path = File.expand_path(path)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, body)
  path
end
if step['commit_files'] && !extra.empty?
  system('git', 'add', '--', *extra, out: File::NULL, err: File::NULL) &&
    system('git', 'commit', '-q', '-m', "fake #{phase} files", '--', *extra, out: File::NULL, err: File::NULL)
end

files = step['write'].map { |name| File.join(outdir.to_s, name) }
files.each do |path|
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "#{phase} output\n")
end
if step['commit'] && !files.empty?
  system('git', 'add', '--', *files, out: File::NULL, err: File::NULL) &&
    system('git', 'commit', '-q', '-m', "fake #{phase}", '--', *files, out: File::NULL, err: File::NULL)
end

tool = { 'type' => 'tool_use', 'id' => 'toolu_1', 'name' => 'Write', 'input' => { 'file_path' => files.first.to_s } }
content = [tool]
content << { 'type' => 'text', 'text' => step['text'] } if step['text']
puts JSON.generate('type' => 'assistant', 'message' => { 'role' => 'assistant', 'content' => content },
                   'parent_tool_use_id' => nil, 'session_id' => session)

unless step['no_result']
  usage = { 'inputTokens' => 10, 'outputTokens' => 20, 'cacheReadInputTokens' => 30,
            'cacheCreationInputTokens' => 40, 'costUSD' => 0.5 }
  puts JSON.generate('type' => 'result', 'subtype' => 'success', 'is_error' => false, 'result' => step['text'] || 'done',
                     'session_id' => session, 'num_turns' => 2, 'duration_ms' => 1500,
                     'total_cost_usd' => 0.5, 'modelUsage' => { 'fake-model' => usage })
end
exit step['exit']
