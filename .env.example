# Create this file with 'task setup' (also generates SECRET_KEY_BASE and
# fills in UID/GID), or copy this file to .env and fill it in by hand.

# ===== review queue =====
# Build the queue image from your workspace Dockerfile instead of the bare
# base image (must start with: FROM autoreviewer-base:local)
#QUEUE_DOCKERFILE=workspace/Dockerfile

# Host uid/gid: set automatically by 'task setup'; required when your host
# uid is not 1000 and you bypass task.
#UID=1000
#GID=1000

# Absolute host path of this repo checkout; set automatically by 'task setup'.
# The container mounts it at the SAME path so git worktrees (which bake in
# absolute paths) resolve identically on the host and in the container. If you
# move the checkout, re-run 'task setup' or update this by hand.
#REPO_ROOT=

# GitHub token for the gh CLI, used to ingest PR metadata (topics like
# pr123). Fine-grained or classic PAT with read access to the target repos.
# https://github.com/settings/tokens
#GH_TOKEN=

# Push findings commits automatically after each review ('task ssh-setup' first)
AUTO_PUSH=0

# Project used when enqueueing a bare topic id with no project name
#DEFAULT_PROJECT=postgres

# Git identity for findings commits (pushed when AUTO_PUSH=1). Unset falls back
# to the image default (autoreviewer <autoreviewer@localhost>), which is fine
# for local-only reviews but not what you want on pushed commits.
#GIT_AUTHOR_NAME=
#GIT_AUTHOR_EMAIL=
#GIT_COMMITTER_NAME=
#GIT_COMMITTER_EMAIL=

# ===== webapp =====
# none = no login (compose binds the port to 127.0.0.1 by default - verify before changing that); unset = Google OIDC
AUTH_MODE=none
WEBAPP_PORT=8080
# Required in production mode: generate with 'openssl rand -hex 64'
SECRET_KEY_BASE=
# Only needed for Google OIDC (AUTH_MODE unset); also fill webapp/config/access.yaml
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Background reindex interval in seconds
#REINDEX_INTERVAL=60

# ===== proxy override (compose.proxy.yaml) =====
#PROXY_NETWORK=caddy
# Set to 1 when behind a TLS-terminating proxy: forces https, HSTS, secure cookies.
# Leave unset for the default plain-http deployment.
#FORCE_SSL=1
