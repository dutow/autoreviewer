# Set to "none" to skip Google login entirely (localhost/trusted networks only).
AUTH_MODE=
# Google OIDC client (Google Cloud console -> credentials; redirect URI:
# <scheme>://<host>/auth/google_oauth2/callback — add http://localhost:3939 for dev)
# Not needed when AUTH_MODE=none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# rails secret; generate with: bin/rails secret
SECRET_KEY_BASE=
# workspace root the app reads: one project dir per subdir (prod compose sets /workspace)
REVIEWS_ROOT=/home/you/workspace
# sqlite location (prod compose sets /data/production.sqlite3)
DATABASE_PATH=
# reindex interval seconds (default 60)
REINDEX_INTERVAL=
# set to 1 only when behind a TLS-terminating proxy (forces https/HSTS/secure cookies)
#FORCE_SSL=1
