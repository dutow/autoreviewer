.page
  h1 Costs
  nav.filters
    = link_to "all", list_url("project" => nil), class: params[:project].blank? ? "active" : nil
    - @projects.each do |p|
      = link_to p, list_url("project" => p), class: params[:project] == p ? "active" : nil
  nav.filters
    = link_to "all routes", list_url("route" => nil), class: params[:route].blank? ? "active" : nil
    - @routes.each do |r|
      = link_to r, list_url("route" => r), class: params[:route] == r ? "active" : nil
  table.reviews.costs
    thead
      tr
        th.day rowspan=2 Day
        th.grp colspan=3 All
        th.grp colspan=3 First review
        th.grp colspan=3 Re-review
      tr
        - 3.times do
          th.grp Reviews
          th Total
          th Avg
    tbody
      - @stats.days.each do |row|
        = render "row", row: row, label: row.day.iso8601
    tfoot
      = render "row", row: @stats.totals, label: "all days"
  p.skipped.dim = "#{pluralize(@stats.skipped, "review")} not counted (no cost data)"
