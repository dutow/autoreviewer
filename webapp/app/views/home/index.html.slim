.page
  h1 All reviews
  nav.filters
    = link_to "all", list_url("project" => nil), class: params[:project].blank? ? "active" : nil
    - @projects.each do |p|
      = link_to p, list_url("project" => p), class: params[:project] == p ? "active" : nil
  = render "shared/version_toggle"
  = render "shared/severity_filter"
  = render "shared/review_table", reviews: @reviews
  = render "shared/pager"
