- if @page_count > 1
  nav.pager
    - if @page > 1
      = link_to "‹ prev", list_url("page" => @page - 1)
    - (1..@page_count).each do |n|
      = link_to n, list_url("page" => n), class: n == @page ? "active" : nil
    - if @page < @page_count
      = link_to "next ›", list_url("page" => @page + 1)
