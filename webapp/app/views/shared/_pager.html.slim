- if @page_count > 1
  nav.pager
    - if @page > 1
      = link_to "‹ prev", url_for(request.query_parameters.slice("project", "versions").merge("page" => @page - 1))
    - (1..@page_count).each do |n|
      = link_to n, url_for(request.query_parameters.slice("project", "versions").merge("page" => n)), class: n == @page ? "active" : nil
    - if @page < @page_count
      = link_to "next ›", url_for(request.query_parameters.slice("project", "versions").merge("page" => @page + 1))
